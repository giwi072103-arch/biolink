# Токен бота, полученный у @BotFather
BOT_TOKEN=8694872534:AAG7ECHc_jeIiurfx6iBi8__SvQbiUeoVwA

# Публичный адрес сайта (без слэша на конце), нужен боту для ссылки на регистрацию
SITE_URL=http://localhost:3000

# Секрет для подписи JWT — сгенерируй случайную строку перед деплоем
JWT_SECRET=change-me-to-a-random-string

# Порт сервера (Railway подставит свой автоматически)
PORT=3000

# Максимальный размер загружаемого файла (фото/видео фон, музыка), в мегабайтах
MAX_UPLOAD_MB=100

# Хранилище: json (по умолчанию, файл data/db.json, без нативных зависимостей)
# или sqlite (файл data/db.sqlite, требует `npm install better-sqlite3`)
DB_DRIVER=json
